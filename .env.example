DATABASE_URL=postgres://postgres:postgres@localhost:5432/fatoora
REDIS_URL=redis://localhost:6379
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never in the database or its backups. Losing it means re-onboarding every device.
MASTER_KEY=
# sandbox | simulation | production
ZATCA_ENV=sandbox
FILES_ROOT=./data/files
